{
  "datasets": [
    {
      "name": "af1cb384",
      "displayName": "Genie Billing",
      "queryLines": [
        "SELECT\n",
        "  u.usage_date,\n",
        "  u.workspace_id,\n",
        "  u.identity_metadata.run_as AS user_identity,\n",
        "  u.usage_metadata.genie.surface AS surface,\n",
        "  u.usage_metadata.genie.channel AS channel,\n",
        "  COALESCE(u.usage_metadata.genie.agent_id, 'No Agent') AS agent_id,\n",
        "  u.sku_name,\n",
        "  SUM(u.usage_quantity) AS total_dbus,\n",
        "  SUM(u.usage_quantity * lp.pricing.effective_list.default) AS total_cost\n",
        "FROM\n",
        "  system.billing.usage u\n",
        "    JOIN system.billing.list_prices lp\n",
        "      ON u.cloud = lp.cloud\n",
        "      AND u.sku_name = lp.sku_name\n",
        "      AND u.usage_start_time >= lp.price_start_time\n",
        "      AND (\n",
        "        lp.price_end_time IS NULL\n",
        "        OR u.usage_start_time < lp.price_end_time\n",
        "      )\n",
        "WHERE\n",
        "  u.billing_origin_product = 'GENIE'\n",
        "GROUP BY\n",
        "  ALL\n",
        "ORDER BY\n",
        "  u.usage_date DESC"
      ],
      "columns": [
        {
          "displayName": "week_start",
          "description": "Week bucket for heatmap grouping",
          "expression": "DATE_TRUNC('week', `usage_date`)"
        },
        {
          "displayName": "day_of_week",
          "description": "Day of week number (1=Sun, 7=Sat)",
          "expression": "DAYOFWEEK(`usage_date`)"
        },
        {
          "displayName": "day_name",
          "description": "Short day name with sort prefix",
          "expression": "CASE DAYOFWEEK(`usage_date`) WHEN 1 THEN '1_Sun' WHEN 2 THEN '2_Mon' WHEN 3 THEN '3_Tue' WHEN 4 THEN '4_Wed' WHEN 5 THEN '5_Thu' WHEN 6 THEN '6_Fri' WHEN 7 THEN '7_Sat' END"
        }
      ]
    },
    {
      "name": "assistant_events",
      "displayName": "Genie Assistant Events",
      "queryLines": [
        "SELECT\n",
        "  event_date,\n",
        "  workspace_id,\n",
        "  COUNT(*) AS request_count,\n",
        "  COUNT(DISTINCT event_id) AS unique_requests\n",
        "FROM\n",
        "  system.access.assistant_events\n",
        "WHERE\n",
        "  event_date >= CURRENT_DATE - INTERVAL 90 DAYS\n",
        "GROUP BY\n",
        "  ALL\n",
        "ORDER BY\n",
        "  event_date DESC"
      ]
    },
    {
      "name": "top_users",
      "displayName": "Top Users by Cost",
      "queryLines": [
        "SELECT\n",
        "  u.identity_metadata.run_as AS user_identity,\n",
        "  SUM(u.usage_quantity) AS total_dbus,\n",
        "  SUM(u.usage_quantity * lp.pricing.effective_list.default) AS total_cost,\n",
        "  COUNT(DISTINCT u.usage_date) AS active_days,\n",
        "  COUNT(DISTINCT u.workspace_id) AS workspace_count,\n",
        "  MAX(u.usage_date) AS last_used\n",
        "FROM\n",
        "  system.billing.usage u\n",
        "    JOIN system.billing.list_prices lp\n",
        "      ON u.cloud = lp.cloud\n",
        "      AND u.sku_name = lp.sku_name\n",
        "      AND u.usage_start_time >= lp.price_start_time\n",
        "      AND (\n",
        "        lp.price_end_time IS NULL\n",
        "        OR u.usage_start_time < lp.price_end_time\n",
        "      )\n",
        "WHERE\n",
        "  u.billing_origin_product = 'GENIE'\n",
        "GROUP BY\n",
        "  user_identity\n",
        "ORDER BY\n",
        "  total_cost DESC\n",
        "LIMIT 25"
      ]
    }
  ],
